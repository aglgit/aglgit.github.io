---
import "./projects.scss";
import voltorbImage from "../assets/images/voltorb-flip.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import ImageContainer from "../components/ImageContainer.astro";
const pageTitle = "Projects | Andreas L";
---

<BaseLayout pageTitle={pageTitle}>
    <div id="project-heading">
        <p>
            Here's an incomplete, yet fairly comprehensive, list of my hobby
            projects.
        </p>
    </div>
    <Card>
        <h2>Voltorb Flip</h2>
        <ImageContainer
            href="https://aglgit.github.io/voltorb-flip"
            src={voltorbImage.src}
        />
        <h3>About</h3>
        <p>
            This is a project for me to learn HTML, CSS and
            JavaScript/TypeScript. It is heavily based on Voltorb Flip by
            Brandon Stein as well as the original game.
        </p>
    </Card>
</BaseLayout>
