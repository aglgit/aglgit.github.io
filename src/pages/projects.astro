---
import '../styles/global.css';
import voltorbImage from '../assets/images/voltorb-flip.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
const pageTitle = 'Projects | Andreas L';
---

<BaseLayout pageTitle={pageTitle}>
    <h1>Projects</h1>
    <p>Description.</p>
    <Card>
        <h2>Voltorb Flip</h2>
        <a href="https://aglgit.github.io/voltorb-flip/">
            <img src={voltorbImage.src} />
        </a>
        <h3>About</h3>
        <p>Paragraph text.</p>
    </Card>
</BaseLayout>
