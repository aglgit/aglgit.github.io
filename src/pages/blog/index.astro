---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import LinkWrapper from "../../components/links/LinkWrapper.astro";

const pageTitle = "Blog | Andreas L";
const posts = await Astro.glob("./posts/*.md");
posts.sort(
    (a, b) =>
        Date.parse(b.frontmatter.pubDate.toString()) -
        Date.parse(a.frontmatter.pubDate.toString())
);
---

<BaseLayout pageTitle={pageTitle}>
    <p>Get the RSS feed <a href="/blog/rss.xml">here</a>.</p>
    {
        posts.map((post: any) => (
            <LinkWrapper href={post.url}>
                <Card>
                    <p>
                        {new Date(post.frontmatter.pubDate).toLocaleDateString(
                            "en-US",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            }
                        )}
                    </p>
                    <h2>{post.frontmatter.title}</h2>
                    <img
                        src={post.frontmatter.image.url}
                        alt={post.frontmatter.image.alt}
                        width="300"
                    />
                    <p>{post.frontmatter.description}</p>
                </Card>
            </LinkWrapper>
        ))
    }
</BaseLayout>
