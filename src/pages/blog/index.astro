---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
const pageTitle = "Blog | Andreas L";

const identity = {
    firstName: "Andreas",
    country: "Northern Europe",
    occupation: "Full stack developer",
    hobbies: ["books", "running"],
};

const skills = ["HTML", "CSS", "TypeScript", "Astro"];

const allPosts = Object.values(
    import.meta.glob("./posts/*.md", { eager: true })
);
---

<BaseLayout pageTitle={pageTitle}>
    <h1>My Astro Learning Blog</h1>
    <p>This is where I will post about my journey learning Astro.</p>
    {
        allPosts.map((post: any) => (
            <li>
                <a href={post.url}>{post.frontmatter.title}</a>
            </li>
        ))
    }

    <p>Quick facts:</p>
    <ul>
        <li>Name: {identity.firstName}</li>
        <li>
            I live in {identity.country} and work as a {identity.occupation}
        </li>
        {
            identity.hobbies.length >= 2 && (
                <li>
                    Two of my hobbies are: {identity.hobbies[0]} and{" "}
                    {identity.hobbies[1]}
                </li>
            )
        }
    </ul>
    <p>My skills are:</p>
    <ul>
        {skills.map((skill) => <li>{skill}</li>)}
    </ul>
</BaseLayout>
